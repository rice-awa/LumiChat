{
	"schemaVersion": 1,
	"id": "${id}",
  "version": "${version}",
  "name": "${name}",
	"description": "A MC Fabric mod integrating LLM chat functionality, supporting multiple AI services and custom features",
	"authors": [
		"rice-awa"
	],
	"contact": {
		"homepage": "https://rice-awa.top",
		"sources": "https://github.com/rice-awa/lumichat"
	},
	"license": "MIT",
	"icon": "assets/lumichat/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.riceawa.Lllmchat"
		],
		"client": [
			"com.riceawa.LllmchatClient"
		],
		"fabric-datagen": [
			"com.riceawa.LllmchatDataGenerator"
		]
	},
	"mixins": [
		"lumichat.mixins.json",
		{
			"config": "lumichat.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${fabric_loader}",
		"minecraft": "${minecraft}",
		"fabric-api": ">=${fabric_api}"
	}
}