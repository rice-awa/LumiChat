+++        CountDownLatch failureEntered = new CountDownLatch(1);
+++
+++        try {
+++            CompletableFuture<String> failed = manager.submitRequest(() -> {
+++                failureEntered.countDown();
+++                throw new AssertionError("task failed");
+++            }, "failed");
